multicast:
  address: 239.0.0.1          # Multicast IP address to capture
  port: 5004                   # Multicast port to capture
  interface: "any"         # Interface name (Linux: e.g. eth0) or IP address (Windows: e.g. 192.168.1.10)

unicast:
  control_port: 5100           # Sender control plane listening port
  data_port: 5101              # Sender data plane streaming port
  max_sessions: 8              # Maximum allowed concurrent receiver sessions

keepalive:
  interval: 1                  # KeepAlive monitoring interval (seconds)

fec:
  enabled: false               # Enable or disable Reed-Solomon FEC redundancy
  k: 8                         # Number of data blocks (k)
  n: 10                        # Total number of blocks (n, n - k = parity blocks)

encryption:
  enabled: false               # Enable or disable AES-GCM encryption & challenge auth
  # ⚠️ SECURITY WARNING: passphrase is stored as plaintext.
  # Do NOT commit the actual send.yaml file to a public repository.
  # Copy this file to send.yaml and edit it locally.
  passphrase: ""              # Shared passphrase (stored in plaintext)

log:
  level: INFO                  # Log level (DEBUG / INFO / WARN / ERROR)
  file: send.log               # Log file output path
