sender:
  address: 127.0.0.1           # Unicast IP address of the sender
  control_port: 5100           # Control plane port of the sender
  data_port: 5101              # Data plane port of the sender

multicast:
  address: 239.0.0.1          # Target multicast address to re-emit
  port: 5004                   # Target multicast port to re-emit
  interface: "any"         # Interface name (Linux: e.g. eth0) or IP address (Windows: e.g. 192.168.1.10)

keepalive:
  interval: 1                  # KeepAlive transmission interval (seconds)

fec:
  enabled: false               # Enable or disable FEC recovery

encryption:
  enabled: false               # Enable or disable AES-GCM encryption & challenge auth
  # ⚠️ SECURITY WARNING: passphrase is stored as plaintext.
  # Do NOT commit the actual recv.yaml file to a public repository.
  # Copy this file to recv.yaml and edit it locally.
  passphrase: ""              # Shared passphrase (stored in plaintext)

log:
  level: INFO                  # Log level (DEBUG / INFO / WARN / ERROR)
  file: recv.log               # Log file output path
